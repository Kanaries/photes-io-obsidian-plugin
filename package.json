		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "1.11.4",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@noble/hashes": "1.8.0"
	}
